<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Follow-up Item</label>
    <pluralLabel>Follow-up Items</pluralLabel>
    <description>One record per follow-up work item (the ledger). Written by the advisor follow-up system; History is a related list, never edited.</description>
    <nameField>
        <label>Work item id</label>
        <type>Text</type>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <enableActivities>false</enableActivities>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <fields>
